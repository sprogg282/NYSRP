# Firebase web app configuration (public client values from Firebase Console).
# These are not admin/service-account secrets; Firestore rules enforce access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional public community links and report intake.
VITE_DISCORD_URL=
VITE_ROBLOX_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Private server-side webhook. Never prefix this with VITE_.
DISCORD_REPORT_WEBHOOK_URL=
